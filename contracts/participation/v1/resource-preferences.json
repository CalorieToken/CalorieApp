    "compute_limit_percent": 25,
    "wifi_only": true,
    "allow_battery": false,
    "idle_compute_only": true,
    "auto_start": false
  },
  "supported_task_classes": [
    "store-synthetic-public-shard.v1",
    "catalog-integrity-summary.v1"
