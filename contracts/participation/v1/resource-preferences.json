    "ordinary_gameverse_access_requires_participation": false,
    "auto_start_requires_explicit_opt_in": true,
    "unknown_task_classes_fail_closed": true,
    "limits_are_user_changeable": true,
    "real_device_detection_implemented": false,
    "real_os_scheduler_integration_implemented": false
  }
}
