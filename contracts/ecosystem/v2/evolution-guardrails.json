    "applicable_licences_privacy_law_and_third_party_rights_still_apply": true
  },
  "official_state_boundary": {
    "official_namespace": "calorieapp-official",
    "official_registry_and_service_operator_controlled": true,
    "direct_external_database_mutation_allowed": false,
    "direct_external_identity_or_session_store_access_allowed": false,
    "community_claim_may_overwrite_official_or_source_assertion": false,
    "community_project_may_claim_official_status_or_brand_authority": false,
    "independent_extension_auto_installed_or_federated": false,
    "official_service_access_is_revocable_and_scoped": true,
    "revoking_official_service_access_revokes_right_to_independent_development": false
  },
  "official_adoption_process": {
    "versioned_proposal_required": true,
    "problem_user_value_and_scope_required": true,
    "threat_privacy_and_abuse_analysis_required": true,
