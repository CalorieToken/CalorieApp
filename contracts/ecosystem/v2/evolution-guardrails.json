{
  "contract_id": "calorieapp.v2-ecosystem-evolution-guardrails",
  "contract_version": "1.0.0",
  "status": "direction-contract-official-adoption-controlled-independent-evolution-free",
  "purpose": "Give the Calorie ecosystem a stable safety direction while allowing independent namespaced evolution without unauthorized mutation of official products or state.",
  "constitutional_invariants": [
    "voluntary-participation-and-purpose-specific-consent",
    "privacy-and-data-minimization",
    "source-provenance-and-no-silent-overwrite",
    "source-specific-licence-and-attribution-respect",
    "identity-bridge-and-private-history-separation",
    "non-custodial-and-non-financial-v2-boundary",
    "no-automatic-fee-bearing-or-ledger-mutation",
    "portable-versioned-interfaces-and-user-data-rights",
    "historical-record-corrections-preserve-superseded-state"
  ],
  "independent_evolution": {
    "allowed": true,
    "allowed_examples": [
      "namespaced-source-adapter",
      "independent-dataset",
      "independent-client-or-application",
      "new-analysis-or-visualization",
      "compatible-schema-extension",
      "alternative-governance-experiment",
      "lawful-fork-where-the-component-licence-permits"
    ],
    "official_preapproval_required": false,
    "official_service_credentials_required": false,
    "must_use_own_namespace_and_non_official_branding": true,
