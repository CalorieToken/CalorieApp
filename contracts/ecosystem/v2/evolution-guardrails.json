      "community-reviewed",
      "conformant",
      "official-pilot",
      "official-supported",
      "deprecated",
      "revoked-from-official-service"
    ],
    "conformant_means_official_product": false,
    "official_pilot_may_access_production_personal_data_by_default": false,
