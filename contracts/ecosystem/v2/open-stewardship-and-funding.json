{
  "contract_id": "calorie.ecosystem.open-stewardship-and-funding",
  "contract_version": "1.0.0",
  "status": "design-boundary-no-automatic-licence-or-ip-transfer",
  "ecosystem": "calorie-ecosystem",
  "products": [
    "CalorieApp",
    "CalorieVerse",
    "Creator Gallery"
  ],
  "open_building": {
    "independent_compatible_projects_allowed": true,
    "official_preapproval_required_for_independent_project": false,
    "own_namespace_and_non_misleading_branding_required": true,
    "public_versioned_protocols_target": true,
    "open_reference_sdk_target": true,
    "existing_repository_automatically_relicensed": false,
    "candidate_open_software_licence": "Apache-2.0",
    "licence_activation_requires_provenance_review": true,
    "licence_activation_requires_explicit_rights_holder_approval": true,
    "file_or_component_manifest_required": true
  },
  "intellectual_property": {
    "official_trademarks_separate_from_code_licences": true,
    "creator_original_work_default_owner": "creator",
    "platform_creator_licence_target": "narrow-non-exclusive-host-display-moderate-technical-transform",
    "commercial_sublicensing_requires_separate_terms": true,
    "compatibility_does_not_equal_official_status": true,
    "future_ip_stewardship_transfer_possible": true,
    "future_transfer_automatic": false,
    "registry_recordal_required_when_applicable": true
  },
  "free_core": {
    "calorieverse_entry_requires_payment": false,
    "ordinary_gallery_browsing_requires_payment": false,
    "wallet_required": false,
    "node_participation_required": false,
    "premium_features_must_be_additive": true,
    "pay_to_win": false
  },
  "commercial_sustainability": {
    "premium_app_features_allowed": true,
    "premium_creator_tools_allowed": true,
    "managed_hosting_api_data_services_allowed": true,
    "enterprise_support_allowed": true,
    "cosmetic_world_content_allowed_if_non_pay_to_win": true,
    "marketplace_fees_require_separate_review": true,
    "founder_cost_recovery_recognised": true,
    "founder_developer_compensation_recognised": true,
    "ecosystem_treasury_long_term_funding_goal": true,
    "fixed_revenue_percentages_set": false,
    "percentages_require_explicit_approval": true,
    "accounting_and_tax_review_required": true
  },
  "funding_phases": [
    {
      "id": "build-and-recovery",
      "priority": [
        "operating-costs",
        "legal-security-compliance",
        "documented-development-costs",
        "reasonable-founder-developer-compensation",
        "service-reserve"
      ]
    },
    {
      "id": "shared-growth",
      "priority": [
        "continued-operations-and-compensation",
        "recorded-ecosystem-treasury-allocation"
      ]
    },
    {
      "id": "mature-stewardship",
      "priority": [
        "ecosystem-infrastructure",
        "security-and-moderation",
        "creator-tooling",
        "community-grants",
        "approved-maintenance"
      ],
      "ecosystem_surplus_may_be_primary_beneficiary": true,
      "indefinite_unilateral_founder_treasury_control_required": false
    }
  ],
  "governance_separation": {
    "premium_purchase_grants_governance": false,
    "token_ownership_grants_automatic_governance": false,
    "node_contribution_grants_automatic_governance": false,
    "privacy_or_consent_may_be_overridden_by_governance": false
  },
  "future_stewardship_entity": {
    "legal_vehicle_selected": false,
    "dutch_stichting_is_candidate_not_decision": true,
    "legal_tax_governance_review_required": true,
    "trademark_or_ip_transfer_requires_signed_instrument": true
  },
  "eu_commercial_launch_gates": [
    "consumer-digital-content-and-service-terms",
    "vat-and-oss-review",
    "gdpr-privacy-review",
    "dsa-platform-ugc-review-when-applicable",
    "minor-age-safety-review",
    "refund-chargeback-fraud-process",
    "separate-mica-crypto-review-before-real-token-rails"
  ]
}
