{
  "contract_id": "calorieapp.v2-abuse-capacity-and-mutation-safety",
  "contract_version": "1.0.0",
  "status": "partial-release-blocking",
  "purpose": "Keep the free V2 service and wider ecosystem available without allowing request amplification, uncontrolled data growth or unauthorized mutation.",
  "principles": {
    "deny_or_degrade_before_existing_user_data_is_endangered": true,
    "external_integration_default_access": "read-only",
    "least_privilege_required": true,
    "direct_ecosystem_database_or_identity_store_access_allowed": false,
    "nested_retry_amplification_allowed": false,
    "silent_data_overwrite_allowed": false,
    "automatic_fee_bearing_or_ledger_mutation_allowed": false
  },
  "human_control_boundary": {
    "fully_autonomous_operation_allowed": false,
    "human_approval_required_for_limit_policy_scope_expansion": true,
    "human_incident_command_and_emergency_pause_required": true,
    "automated_block_must_have_false_positive_review_and_appeal": true,
    "automation_may_self_authorize_broader_mutation": false,
    "emergency_override_may_ignore_privacy_security_or_rights_invariants": false
  },
  "ecosystem_freedom_boundary": {
    "contract": "contracts/ecosystem/v2/evolution-guardrails.json",
    "independent_namespaced_extensions_allowed": true,
    "independent_implementation_requires_official_service_access": false,
    "official_state_protection_may_be_used_to_forbid_all_independent_evolution": false,
    "official_adoption_and_independent_development_are_separate": true
  },
  "limit_keys": {
    "layers": [
      "route-global",
      "source-adapter",
      "registered-client",
      "authenticated-pseudonymous-subject",
      "short-lived-network-signal"
    ],
    "raw_ip_long_term_storage_allowed": false,
    "raw_search_query_in_abuse_profile_allowed": false,
    "rotating-keyed-network_fingerprint_required_when_network_signal_is_stored": true,
    "shared-mobile-or-household-network_fairness_required": true,
    "ip_signal_may_be_sole_long_term_identity": false
  },
  "request_controls": {
    "route_specific_limits_required": true,
    "request_body_size_limit_required": true,
    "field_count_and_string_length_limits_required": true,
    "pagination_has_hard_maximum": true,
    "search_as_you_type_external_requests_allowed": false,
    "duplicate_in_flight_read_coalescing_required": true,
    "bounded_per_adapter_concurrency_required": true,
    "bounded_queue_with_backpressure_required": true,
    "queue_overflow_response": "503-with-bounded-retry-after",
    "rate_limit_response": "429-with-bounded-retry-after"
  },
  "retry_controls": {
    "single_end_to_end_budget_per_user_action": true,
    "max_open_food_facts_attempts_per_search": 2,
    "nested_transport_retries_allowed": false,
    "unsafe_mutation_automatic_retry_allowed": false,
    "idempotent_retry_requires_idempotency_key": true,
    "exponential_backoff_with_jitter_required": true,
    "provider_retry_after_respected": true,
    "retry_after_has_client_side_maximum": true,
    "circuit_breaker_required_per_external_source": true,
    "retry_storm_after_recovery_allowed": false
  },
  "provider_registry": {
    "required_per_adapter_fields": [
      "provider_key",
      "endpoint_class",
      "published_limit",
      "calorieapp_safety_budget",
      "timeout",
      "concurrency",
      "retry_budget",
      "cache_or_coalescing_policy",
      "contact_and_attribution"
    ],
    "open_food_facts_search": {
      "published_limit_source": "official-api-documentation",
      "published_limit": "10-search-requests-per-minute-per-ip",
      "search_as_you_type_forbidden_by_provider_guidance": true,
      "calorieapp_target_budget": "at-most-8-search-requests-per-minute-per-egress-ip",
      "current_end_to_end_attempt_budget_implemented": 2,
      "shared_egress_rate_governor_implemented": false
    }
  },
  "identity_bridge_controls": {
    "login_start_limit_required_per_client_and_short_lived_network_signal": true,
    "outstanding_state_limit_required": true,
    "status_poll_minimum_interval_seconds": 5,
    "status_poll_adaptive_slowdown_required": true,
    "state_and_handoff_expiry_required": true,
    "expired_transient_cleanup_required": true,
    "callback_replay_block_required": true,
    "session_creation_idempotency_required": true,
    "direct_external_client_session_store_access_allowed": false
  },
  "mutation_controls": {
    "authentication_required": true,
    "purpose_and_scope_authorization_required": true,
    "schema_and_business_rule_validation_required": true,
    "idempotency_key_required_for_retryable_mutation": true,
    "optimistic_concurrency_or_expected_version_required": true,
    "append_only_audit_event_required": true,
    "audit_event_may_contain_secret_or_excess_personal_data": false,
    "community_or_ecosystem_contribution_enters_quarantine": true,
    "moderation_required_before_public_activation": true,
    "contribution_creates_source_assertion_instead_of_overwrite": true,
    "correction_preserves_superseded_assertion": true,
    "production_application_role_may_execute_ddl": false,
    "production_migration_uses_separate_approved_role": true,
    "mass_mutation_requires_dry_run_scope_preview_and_explicit_approval": true,
    "xrpl_transaction_creation_or_signing_automatic": false
  },
  "data_growth_controls": {
    "per_subject_storage_budget_required": true,
    "per_source_ingest_budget_required": true,
    "duplicate_record_idempotency_required": true,
    "unbounded_blob_or_image_ingest_allowed": false,
    "capacity_alert_threshold_percent": [70, 85, 95],
    "provider_neutral_database_size_signal_implemented": true,
    "exact_capacity_limit_requires_operator_configuration": true,
    "new_identity_onboarding_pause_at_percent_implemented": 95,
    "configured_measurement_failure_pauses_new_onboarding": true,
    "existing_identity_login_bypasses_onboarding_pause": true,
    "automatic_paid_upgrade_allowed": false,
    "automatic_existing_history_deletion_allowed": false,
    "new_onboarding_pauses_before_safety_capacity_failure": true
  },
  "observability_and_response": {
    "aggregate_low_cardinality_metrics_required": true,
    "request_content_in_metrics_allowed": false,
    "secrets_or_tokens_in_logs_allowed": false,
    "limit_rejections_source_failures_queue_depth_and_circuit_state_measured": true,
    "alert_and_incident_runbook_required": true,
    "abuse_rule_changes_audited": true,
    "false_positive_review_and_recovery_path_required": true
  },
  "current_implemented_evidence": [
    "search-query-length-and-result-page-bounds",
    "authenticated-log-read-maximum",
    "finite-upstream-timeouts",
    "two-attempt-open-food-facts-end-to-end-budget",
    "no-fallback-bypass-after-upstream-http-status",
    "frontend-retry-after-bounds",
    "five-second-identity-status-poll-interval",
    "identity-state-expiry-cleanup-and-callback-replay-protection",
    "provider-neutral-database-capacity-classification-at-70-85-95-percent",
    "new-identity-onboarding-pause-at-95-percent",
    "configured-capacity-measurement-failure-pauses-new-onboarding",
    "existing-identity-login-bypasses-onboarding-only-capacity-guard",
    "postgresql-database-size-signal-ci-proof"
  ],
  "release_blocking_missing_controls": [
    "shared-route-and-egress-rate-governor",
    "bounded-adapter-concurrency-queue-and-circuit-breaker",
    "request-body-and-data-growth-quotas",
    "identity-start-and-outstanding-state-limits",
    "adaptive-status-poll-slowdown",
    "mutation-quarantine-moderation-audit-and-expected-version-enforcement",
    "capacity-alert-delivery-and-incident-runbook",
    "chosen-provider-exact-quota-configuration-and-live-pause-exercise",
    "multi-instance-and-proxy-topology-test"
  ]
}
