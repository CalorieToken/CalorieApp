{
  "contract_id": "calorieapp.food-data-source-registry",
  "contract_version": "1.5.0",
  "status": "bounded-validated-source-assertion-ingest-implemented-no-public-source-enabled",
  "purpose": "Allow reviewed food-data sources to coexist without making one provider the canonical model or weakening provenance, privacy or licence controls.",
  "principles": {
    "open_food_facts_is_one_adapter_not_canonical_model": true,
    "single_source_database_design_allowed": false,
    "new_source_requires_core_schema_rewrite": false,
    "source_assertions_preserved_separately": true,
    "silent_cross_source_overwrite_allowed": false,
    "private_food_history_is_point_in_time_snapshot": true,
    "later_source_change_may_rewrite_private_history": false,
    "private_history_auto_published_as_catalog_source": false
  },
  "source_categories": [
    "open-dataset",
    "producer-or-farm",
    "processor-or-manufacturer",
    "supplier-or-distributor",
    "retailer-or-restaurant",
    "laboratory-or-certifier",
    "government-or-public-authority",
    "community-contribution",
    "explicit-user-import",
    "ecosystem-adapter"
  ],
  "entities": {
    "food_source": {
      "purpose": "Register the operator, source category, jurisdiction, trust state and reuse terms.",
      "required_fields": [
        "source_id",
        "source_key",
        "source_category",
        "operator_name",
        "status",
        "licence_id",
        "terms_reference",
        "attribution_text",
        "record_limit",
        "assertion_limit"
      ]
    },
    "food_source_record": {
      "purpose": "Represent an immutable retrieved or submitted source record without treating it as the normalized product.",
      "required_fields": [
        "source_record_id",
        "source_id",
        "external_record_id",
        "source_version_or_content_digest",
        "retrieved_or_submitted_at",
        "verification_status",
        "verification_version"
      ]
    },
    "food_source_moderation_audit": {
      "purpose": "Preserve minimal append-only evidence for one terminal source-record moderation decision.",
      "required_fields": [
        "source_record_id",
        "idempotency_key",
        "expected_version",
        "resulting_version",
        "previous_status",
        "new_status",
        "moderator_reference",
        "authorization_scope",
        "reason_code",
        "created_at"
      ]
    },
    "food_product": {
      "purpose": "Provide an internal source-neutral identity for a food or product.",
      "required_fields": ["food_product_id", "created_at", "status"]
    },
    "food_product_source_link": {
      "purpose": "Map source records to an internal product with reviewable matching evidence.",
      "required_fields": [
        "link_id",
        "food_product_id",
        "source_record_id",
        "match_method",
        "match_confidence",
        "review_status",
        "created_at"
      ]
    },
    "food_attribute_assertion": {
      "purpose": "Keep source-specific facts separate so disagreement remains traceable.",
      "required_fields": [
        "assertion_id",
        "food_product_id",
        "source_record_id",
        "attribute_key",
        "value",
        "unit_or_value_type",
        "observed_or_effective_at",
        "verification_status",
        "verification_version",
        "created_at"
      ],
      "optional_fields": [
        "supersedes_assertion_id"
      ]
    },
    "food_attribute_assertion_ingest_audit": {
      "purpose": "Preserve a minimal append-only receipt for one bounded internal source-assertion ingest.",
      "required_fields": [
        "assertion_id",
        "food_product_id",
        "source_record_id",
        "idempotency_key",
        "expected_source_record_version",
        "resulting_assertion_version",
        "submitter_reference",
        "authorization_scope",
        "created_at"
      ]
    },
    "food_log_snapshot": {
      "purpose": "Preserve what a user chose and saw at logging time without later catalog mutation.",
      "required_fields": [
        "food_log_id",
        "calorieapp_user_id",
        "snapshot_values",
        "logged_at"
      ],
      "optional_fields": ["food_product_id", "source_record_ids"]
    }
  },
  "adapter_contract": {
    "versioned": true,
    "normalized_output_required": true,
    "idempotency_key": [
      "source_id",
      "external_record_id",
      "source_version_or_content_digest"
    ],
    "raw_payload_storage_required": false,
    "raw_payload_digest_allowed": true,
    "provider_limit_registry_required": true,
    "per_source_persisted_record_budget_implemented": true,
    "duplicate_idempotency_key_consumes_budget": false,
    "per_source_persisted_assertion_budget_implemented": true,
    "duplicate_assertion_idempotency_key_consumes_budget": false,
    "max_upstream_attempts_per_user_action": 2,
    "nested_retry_layers_allowed": false,
    "bounded_concurrency_and_queue_required": true,
    "bounded_retry_and_rate_limit_compliance_required": true,
    "source_specific_schema_may_define_core_schema": false,
    "upstream_write_enabled_by_default": false
  },
  "conflict_policy": {
    "retain_each_source_assertion": true,
    "deterministic_presentation_policy_required": true,
    "presentation_value_must_expose_provenance": true,
    "automatic_claim_of_truth_allowed": false,
    "silent_overwrite_or_destructive_merge_allowed": false,
    "assertion_must_reference_reviewable_product_source_pair": true,
    "correction_keeps_prior_assertion_row": true,
    "correction_must_keep_product_and_source_record_lineage": true
  },
  "assertion_content_policy": {
    "policy_version": "1.0.0",
    "applied_before_database_work": true,
    "initial_scope": "source-neutral-nutrition-per-100g",
    "unknown_attribute_allowed": false,
    "arbitrary_text_value_allowed": false,
    "unit_must_match_attribute_policy": true,
    "numeric_format": "finite-non-negative-decimal-with-at-most-6-fractional-digits",
    "equivalent_decimal_forms_canonicalized_before_idempotency_check": true,
    "policy_extension_requires_human_review": true,
    "allowed_numeric_attributes": {
      "nutrition.energy": {
        "unit": "kcal-per-100g",
        "minimum": "0",
        "maximum": "1000",
        "max_fractional_digits": 6
      },
      "nutrition.energy-kj": {
        "unit": "kj-per-100g",
        "minimum": "0",
        "maximum": "5000",
        "max_fractional_digits": 6
      },
      "nutrition.protein": {
        "unit": "g-per-100g",
        "minimum": "0",
        "maximum": "100",
        "max_fractional_digits": 6
      },
      "nutrition.fat": {
        "unit": "g-per-100g",
        "minimum": "0",
        "maximum": "100",
        "max_fractional_digits": 6
      },
      "nutrition.saturated-fat": {
        "unit": "g-per-100g",
        "minimum": "0",
        "maximum": "100",
        "max_fractional_digits": 6
      },
      "nutrition.carbohydrates": {
        "unit": "g-per-100g",
        "minimum": "0",
        "maximum": "100",
        "max_fractional_digits": 6
      },
      "nutrition.sugars": {
        "unit": "g-per-100g",
        "minimum": "0",
        "maximum": "100",
        "max_fractional_digits": 6
      },
      "nutrition.fiber": {
        "unit": "g-per-100g",
        "minimum": "0",
        "maximum": "100",
        "max_fractional_digits": 6
      },
      "nutrition.salt": {
        "unit": "g-per-100g",
        "minimum": "0",
        "maximum": "100",
        "max_fractional_digits": 6
      },
      "nutrition.sodium": {
        "unit": "g-per-100g",
        "minimum": "0",
        "maximum": "100",
        "max_fractional_digits": 6
      }
    }
  },
  "mutation_policy": {
    "external_client_default_access": "read-only",
    "direct_catalog_table_write_allowed": false,
    "contribution_creates_new_assertion": true,
    "contribution_quarantined_until_validation_and_moderation": true,
    "schema_validation_required": true,
    "idempotency_key_required": true,
    "optimistic_concurrency_or_expected_version_required": true,
    "append_only_audit_event_required": true,
    "source_record_terminal_moderation_implemented": true,
    "source_record_moderation_requires_expected_version": true,
    "source_record_moderation_requires_idempotency_key": true,
    "source_record_moderation_audit_is_insert_only_in_service": true,
    "source_record_moderation_audit_allows_free_text_or_payload": false,
    "catalog_entity_tables_implemented": true,
    "catalog_assertion_write_service_implemented": true,
    "source_assertion_ingest_implemented": true,
    "source_assertion_ingest_authorization_scope": "catalog:source-assertion:ingest",
    "source_assertion_ingest_requires_validated_record_and_link": true,
    "source_assertion_ingest_requires_active_product_and_enabled_source": true,
    "source_assertion_ingest_requires_expected_record_version": true,
    "source_assertion_ingest_requires_idempotency_key": true,
    "source_assertion_ingest_content_policy_version": "1.0.0",
    "source_assertion_ingest_unknown_attribute_allowed": false,
    "source_assertion_ingest_arbitrary_text_value_allowed": false,
    "source_assertion_ingest_unit_must_match_attribute_policy": true,
    "source_assertion_ingest_equivalent_decimal_forms_canonicalized": true,
    "source_assertion_content_policy_extension_requires_human_review": true,
    "source_assertion_ingest_defaults_to_quarantine": true,
    "source_assertion_ingest_audit_inserted_atomically": true,
    "source_assertion_ingest_audit_is_insert_only_in_service": true,
    "source_assertion_ingest_audit_allows_free_text_payload_email_or_ip": false,
    "source_assertion_correction_service_implemented": false,
    "source_assertion_moderation_service_implemented": false,
    "public_source_assertion_ingest_endpoint_enabled": false,
    "read_only_licensed_assertion_evidence_export_implemented": true,
    "complete_source_assertion_mutation_flow_implemented": false,
    "silent_history_or_source_record_rewrite_allowed": false,
    "correction_preserves_superseded_assertion": true
  },
  "licensing": {
    "licence_review_required_before_source_enablement": true,
    "licence_identifier_and_terms_reference_required": true,
    "attribution_preserved_per_source": true,
    "share_alike_obligations_preserved": true,
    "incompatible_sources_may_be_flattened_into_one_export": false,
    "source_specific_export_controls_required": true,
    "assertion_evidence_export_preserves_source_licence_and_attribution": true
  },
  "privacy_and_identity": {
    "catalog_and_private_history_separated": true,
    "community_submission_requires_explicit_action": true,
    "community_submission_requires_moderation": true,
    "identity_bridge_may_attest_contributor_role": true,
    "public_contributor_reference_must_be_pseudonymous": true,
    "private_identity_fields_allowed_in_catalog": false,
    "food_history_auto_contribution_allowed": false
  },
  "future_provenance": {
    "xrpl_link_may_attach_to_reviewed_source_or_supply_chain_event": true,
    "xrpl_link_auto_attaches_to_private_food_log": false,
    "public_transaction_hash_may_resolve_private_identity_or_history": false,
    "postgresql_remains_primary_graph_and_catalog_store": true
  },
  "implementation": {
    "current_adapter": "open_food_facts",
    "current_adapter_catalog_persistence_enabled": false,
    "implemented_catalog_tables": [
      "food_source",
      "food_source_record",
      "food_source_moderation_audit",
      "food_product",
      "food_product_source_link",
      "food_attribute_assertion",
      "food_attribute_assertion_ingest_audit"
    ],
    "remaining_catalog_tables": [],
    "internal_source_record_ingest_service_implemented": true,
    "internal_source_record_terminal_moderation_service_implemented": true,
    "source_neutral_catalog_entity_foundation_implemented": true,
    "read_only_licensed_assertion_evidence_export_implemented": true,
    "catalog_assertion_write_service_implemented": true,
    "internal_source_assertion_ingest_service_implemented": true,
    "source_assertion_content_policy_implemented": true,
    "source_assertion_ingest_defaults_to_quarantine": true,
    "source_assertion_correction_service_implemented": false,
    "source_assertion_moderation_service_implemented": false,
    "public_source_assertion_ingest_endpoint_enabled": false,
    "public_catalog_read_endpoint_enabled": false,
    "general_source_record_update_or_delete_service_implemented": false,
    "public_source_record_moderation_endpoint_enabled": false,
    "ingest_defaults_to_quarantine": true,
    "raw_source_payload_column_created": false,
    "source_independent_schema_compatibility_required_for_v2": true,
    "additional_source_activation_required_for_v2": false,
    "v2_forward_migration_required": false,
    "current_release_dependency": true,
    "public_source_onboarding_enabled": false
  }
}
