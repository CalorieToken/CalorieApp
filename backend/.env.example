# CalorieApp Backend Environment Variables
# Copy this file to .env and adjust values for your environment.

# CORS_ORIGINS: Comma-separated list of allowed frontend origins
# Local development: http://localhost:3000
# Cloud examples: https://app.example.com,http://localhost:3000
# Default: http://localhost:3000
# Use complete origins only: no wildcard, path, trailing slash, query, or credentials.
# Non-localhost origins must use HTTPS because API requests include session cookies.
CORS_ORIGINS=http://localhost:3000

# DATABASE_URL: provider-neutral database connection string
# Local/test: not needed (defaults to backend/calorieapp.db)
# Staging/production: PostgreSQL is mandatory; SQLite fails closed.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Hard database budget in bytes used by the new-account onboarding guard.
# Leave unset until the selected provider's exact live quota is human-reviewed.
# At 95% usage, new accounts pause; existing accounts remain available.
# CALORIEAPP_DATABASE_CAPACITY_LIMIT_BYTES=500000000
# A scheduler or monitoring adapter may run `python -m app.capacity_probe`.
# Its JSON and exit code are safe to route; selecting the alert destination is a
# separate human-approved deployment step.

# PORT: Server port (read by deployment wrapper, not directly by FastAPI)
# Local development: 8000
# Cloud: Usually set automatically by platform (e.g., Render sets PORT)
# Default: 8000
# PORT=8000

# HOST: Server host binding
# Local development: 127.0.0.1 (localhost only)
# Cloud: 0.0.0.0 (accept all interfaces)
# This is configured when starting the server, not via environment variable in the Python code.
# See README.md and backend/start-backend.ps1 for current startup/configuration usage.

# -----------------------------------------------------------------------------
# Identity Bridge / XUMM Integration
# -----------------------------------------------------------------------------

# Base WordPress domain hosting XUMM Login and the CalorieApp bridge.
# Default in code: https://calorietoken.net
WORDPRESS_URL=https://calorietoken.net

# Bridge authorize endpoint used to build xl-signin redirect target.
# Default in code derives from WORDPRESS_URL.
WORDPRESS_BRIDGE_AUTHORIZE_URL=https://calorietoken.net/?calorieapp_authorize=1

# Bridge exchange endpoint for server-to-server code redemption.
# Default in code derives from WORDPRESS_URL.
WORDPRESS_BRIDGE_EXCHANGE_URL=https://calorietoken.net/index.php/wp-json/calorieapp/v1/exchange

# Shared secret used only between backend and WordPress bridge.
# NEVER expose to frontend/browser. Use a random secret in real env files.
WORDPRESS_BRIDGE_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Fixed registered-client identifier used for bridge authentication and login-start admission.
# Required length: 1-120 characters. Browser input never selects this key.
CALORIEAPP_CLIENT_ID=calorieapp-backend

# Deployment environment selector used for startup guardrails.
# Allowed values: local, test, staging, production
CALORIEAPP_ENV=local

# Where the frontend should land after successful callback finalization.
# Must be a local app path beginning with one slash; external or scheme-relative URLs are rejected.
CALORIEAPP_POST_LOGIN_REDIRECT=/

# Pending login state lifetime in seconds (minimum: 60; recommended: 300).
LOGIN_STATE_LIFETIME_SECONDS=300

# Session cookie secure flag (true in production, false only for local HTTP testing).
SESSION_COOKIE_SECURE=true
# Use none only for secure cross-site showcase hosting; keep lax for same-site/local deployments.
SESSION_COOKIE_SAMESITE=lax

# Irreversible primary-store account erasure is disabled until the recovery
# window, backup-erasure schedule, privacy notice and translated UI are approved.
ACCOUNT_ERASURE_ENABLED=false
